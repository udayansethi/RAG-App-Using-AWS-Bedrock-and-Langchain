AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token (optional, for temporary credentials/SSO)
AWS_DEFAULT_REGION=us-east-1

# Optional Bedrock Model ID overrides
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_AMAZON_MODEL=amazon.nova-lite-v1:0
BEDROCK_LLAMA_MODEL=meta.llama3-8b-instruct-v1:0
